# Начальные значения: после первого старта живут в SQLite (data/nodecheck.db)
# и меняются в admin → Настройки. Пусто — сгенерируются и выведутся в лог.
ADMIN_TOKEN=
PIN=

# Домены: по Host приложение понимает режим (admin / status)
ADMIN_HOST=admin.example.com
STATUS_HOST=status.example.com

# Пользователь хоста чекера, под которым веб-терминал открывает ssh на 127.0.0.1
TTYD_USER=
# lo — режим SSH-туннеля, wg0 — режим WireGuard
TTYD_IFACE=lo

# Метка точки проверки в экспорте
VANTAGE=home
