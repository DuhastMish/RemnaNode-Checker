# Начальные значения: после первого старта живут в SQLite (data/panel.db)
# и меняются в admin → Настройки. Пусто — сгенерируются и выведутся в лог.
ADMIN_TOKEN=
PIN=

# Домен admin-панели: на него Caddy получает сертификат; его же панель подставляет в команду запуска чекера
ADMIN_HOST=admin.example.com
# Домен status-страницы: запросы с этим Host — режим status (PIN), все остальные — admin (токен)
STATUS_HOST=status.example.com

# Порт HTTPS встроенного Caddy. 443 занят другим сервисом — укажите другой (например 4443),
# тогда панель будет https://admin.example.com:4443. Порт 80 всё равно нужен свободным (выдача сертификата).
HTTPS_PORT=443

# caddy — поднять встроенный Caddy (HTTPS на 80 и HTTPS_PORT) вместе с панелью.
# Пусто — без него: панель дома за туннелем или свой nginx.
COMPOSE_PROFILES=caddy

# На каком адресе слушает панель (порт 8000):
#   127.0.0.1 — панель на VPS за встроенным Caddy / nginx на этой же машине (рекомендуется: порт не торчит наружу)
#   0.0.0.0   — панель дома за SSH-туннелем / доступ из локальной сети по IP
BIND_HOST=127.0.0.1

# Пользователь хоста панели, под которым веб-терминал открывает ssh на 127.0.0.1
TTYD_USER=
# lo — режим SSH-туннеля, wg0 — режим WireGuard
TTYD_IFACE=lo

