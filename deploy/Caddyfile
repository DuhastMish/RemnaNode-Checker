# Caddy из docker-compose.yml панели (сервис caddy). Домены — из .env: ADMIN_HOST и STATUS_HOST.
# Обе A-записи DNS указывают на IP этой машины. Панель слушает 127.0.0.1:8000, терминал — 127.0.0.1:7681.
#
# Caddy на VPS для панели дома за SSH-туннелем: тот же файл, порты 8000 → 18000 и 7681 → 17681
# (за WireGuard: 127.0.0.1 → 10.8.0.2), запуск — как сервис caddy ниже, с этими же переменными.

{$ADMIN_HOST} {
    handle /ttyd/* {
        reverse_proxy 127.0.0.1:7681
    }
    reverse_proxy 127.0.0.1:8000
}

{$STATUS_HOST} {
    reverse_proxy 127.0.0.1:8000
}
