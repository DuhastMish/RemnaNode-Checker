# /etc/caddy/Caddyfile на машине с панелью (VPS). Обе A-записи DNS указывают на IP этой машины.
# Панель на этом же VPS (BIND_HOST=127.0.0.1): порты 8000 (панель) и 7681 (терминал) — как ниже.
# Панель дома за SSH-туннелем: замените 127.0.0.1:8000 → 127.0.0.1:18000 и 127.0.0.1:7681 → 127.0.0.1:17681.
# Панель дома за WireGuard: замените 127.0.0.1 → 10.8.0.2 (порты 8000 и 7681).

admin.example.com {
    handle /ttyd/* {
        reverse_proxy 127.0.0.1:7681
    }
    reverse_proxy 127.0.0.1:8000
}

status.example.com {
    reverse_proxy 127.0.0.1:8000
}
